# Copy to .env and adjust, or export directly. The first three have defaults; the rest are required only by the script named above them.

BEDROCK_REGION=eu-west-3
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_ATTEMPTS=3

# guardrails.py
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# cost.py: USD per million tokens, from https://aws.amazon.com/bedrock/pricing/
BEDROCK_PRICE_INPUT=
BEDROCK_PRICE_OUTPUT=
BEDROCK_PRICE_CACHE_READ=
BEDROCK_PRICE_CACHE_WRITE=
